# Docker Compose: `env.agent.lab` (Agent / Workload signals) and `env.lab` (workshop-app tracer).
# See those files; Instruqt overwrites them at track start.

# Datadog unified tagging (for SSI-injected tracer).
# Start with: npm start  →  script/start-workshop-app.sh (sources .env, then node).
# Required so DD_* exist before the Agent injects the tracer (avoids env "none").
DD_SERVICE=dash2026-workshop-app
DD_ENV=production
DD_VERSION=1.0.0
DD_APPSEC_ENABLED=true
DD_TAGS=env:production

# App
PORT=3000
NODE_ENV=production

# Optional: JWT sign route (/api/vuln/jwt/sign). Default in src/config.js is a labeled demo key only.
# WORKSHOP_JWT_SECRET=change-me-for-local-testing
